FROM public.ecr.aws/lambda/nodejs:22

# Install system dependencies (curl-minimal is pre-installed in Amazon Linux 2023)
RUN dnf install -y python3.11 tar xz ca-certificates && dnf clean all && \
    ln -sf /usr/bin/python3.11 /usr/local/bin/python && \
    ln -sf /usr/bin/python3.11 /usr/local/bin/python3

# Install ffmpeg static binary (amd64)
RUN curl -sL https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz -o /tmp/ffmpeg.tar.xz && \
    tar -xf /tmp/ffmpeg.tar.xz -C /tmp && \
    cp /tmp/ffmpeg-*-amd64-static/ffmpeg /usr/local/bin/ && \
    cp /tmp/ffmpeg-*-amd64-static/ffprobe /usr/local/bin/ && \
    chmod a+rx /usr/local/bin/ffmpeg /usr/local/bin/ffprobe && \
    rm -rf /tmp/ffmpeg*

# Install yt-dlp standalone binary (yt-dlp_linux bundles its own modern Python)
RUN curl -sL https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp_linux -o /usr/local/bin/yt-dlp && \
    chmod a+rx /usr/local/bin/yt-dlp

# Set working directory to Lambda task root
WORKDIR ${LAMBDA_TASK_ROOT}

# Skip npm preinstall check since standalone yt-dlp binary is already installed
ENV YOUTUBE_DL_SKIP_PYTHON_CHECK=1

# Install dependencies
COPY package*.json ${LAMBDA_TASK_ROOT}/
RUN npm install --omit=dev

# Copy application code
COPY . ${LAMBDA_TASK_ROOT}/

# Default entry point (can be overridden to lambda.handler for API)
CMD [ "worker.handler" ]

