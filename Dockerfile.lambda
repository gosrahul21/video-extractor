FROM public.ecr.aws/lambda/nodejs:22

# Install system dependencies (curl-minimal is pre-installed in Amazon Linux 2023)
RUN dnf install -y python3 tar xz ca-certificates && dnf clean all

# Install ffmpeg static binary (amd64)
RUN curl -sL https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz -o /tmp/ffmpeg.tar.xz && \
    tar -xf /tmp/ffmpeg.tar.xz -C /tmp && \
    cp /tmp/ffmpeg-*-amd64-static/ffmpeg /usr/local/bin/ && \
    cp /tmp/ffmpeg-*-amd64-static/ffprobe /usr/local/bin/ && \
    chmod a+rx /usr/local/bin/ffmpeg /usr/local/bin/ffprobe && \
    rm -rf /tmp/ffmpeg*

# Install yt-dlp standalone binary
RUN curl -sL https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp && \
    chmod a+rx /usr/local/bin/yt-dlp

# Set working directory to Lambda task root
WORKDIR ${LAMBDA_TASK_ROOT}

# Install dependencies
COPY package*.json ${LAMBDA_TASK_ROOT}/
RUN npm install --omit=dev

# Copy application code
COPY . ${LAMBDA_TASK_ROOT}/

# Default entry point (can be overridden to lambda.handler for API)
CMD [ "worker.handler" ]

